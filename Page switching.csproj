<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ScottPlot 的现代 SkiaSharp WinForms 依赖以 Windows 10 2004 为平台基线。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Page_switching</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 内部库统一从本项目的 lib 目录读取，不再依赖 Total 工程的位置。 -->
    <InduLinkLibraryDirectory Condition="'$(InduLinkLibraryDirectory)' == ''">$(MSBuildProjectDirectory)\lib</InduLinkLibraryDirectory>
    <StartupObject>Page_switching.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Controls\AxisMonitoringSummaryControl.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controls\AxisMonitoringSummaryControl.Designer.cs"><SubType>Code</SubType><DependentUpon>AxisMonitoringSummaryControl.cs</DependentUpon></Compile>
    <!-- 对比曲线也保持可编辑的 UserControl Designer 结构。 -->
    <Compile Update="Controls\ComparisonPlotControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\ComparisonPlotControl.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>ComparisonPlotControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\WaveformPreviewControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\*.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="panel\*.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="panel\AxisMonitoringSettingsPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>AxisMonitoringSettingsPage.cs</DependentUpon>
    </Compile>
    <!-- 使用明确的父文件名，让 Visual Studio 和命令行构建采用同一份 Designer 关联。 -->
    <Compile Update="Controls\WaveformPreviewControl.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>WaveformPreviewControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\main_page.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>main_page.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\LoginForm.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>LoginForm.cs</DependentUpon>
    </Compile>
    <Compile Update="panel\AccountManagementPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>AccountManagementPage.cs</DependentUpon>
    </Compile>
    <Compile Update="panel\MachineDiagnosticsPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>MachineDiagnosticsPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\main_page.resx">
      <DependentUpon>main_page.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\auto.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>auto.cs</DependentUpon>
    </Compile>
    <!-- 功能分部文件不是独立控件；避免 VS 为它生成第二份 Auto 资源。 -->
    <Compile Update="panel\auto.Wave.cs">
      <SubType>Code</SubType>
      <DependentUpon>auto.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Remove="panel\auto.Wave.resx" />
    <EmbeddedResource Update="panel\auto.resx">
      <DependentUpon>auto.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\Calibration.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>Calibration.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\Calibration.resx">
      <DependentUpon>Calibration.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\config.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>config.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\config.resx">
      <DependentUpon>config.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\ControlAuthority.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>ControlAuthority.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\ControlAuthority.resx">
      <DependentUpon>ControlAuthority.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\CustomSpectrumPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>CustomSpectrumPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\CustomSpectrumPage.resx">
      <DependentUpon>CustomSpectrumPage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\Data.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>Data.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\Data.resx">
      <DependentUpon>Data.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\IrregularWavePage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>IrregularWavePage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\IrregularWavePage.resx">
      <DependentUpon>IrregularWavePage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\manual.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>manual.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\manual.resx">
      <DependentUpon>manual.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\RegularWavePage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>RegularWavePage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\RegularWavePage.resx">
      <DependentUpon>RegularWavePage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\SignalCorrectionPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>SignalCorrectionPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\SignalCorrectionPage.resx">
      <DependentUpon>SignalCorrectionPage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\Wave_Height_Meter.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>Wave_Height_Meter.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\Wave_Height_Meter.resx">
      <DependentUpon>Wave_Height_Meter.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\WaveAnalysisPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>WaveAnalysisPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\WaveAnalysisPage.resx">
      <DependentUpon>WaveAnalysisPage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\WaveBatchCalibrationPage.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>WaveBatchCalibrationPage.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\WaveBatchCalibrationPage.resx">
      <DependentUpon>WaveBatchCalibrationPage.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="panel\waveform.Designer.cs">
      <SubType>Code</SubType>
      <DependentUpon>waveform.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="panel\waveform.resx">
      <DependentUpon>waveform.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- UI 试用：AntdUI 负责自动页控件，ScottPlot 负责现有采样数据的曲线显示。 -->
    <PackageReference Include="AntdUI" Version="2.4.12" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <!-- DLL 引用不会传递原工程的 NuGet 依赖，显式保留对应版本供运行时使用。 -->
    <!-- 同步更新 ADS 与 Router，包含并发连接及 Router 重启后的连接恢复修复。 -->
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="7.0.389" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.TcpRouter" Version="7.0.389" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InduLinkLibrary Include="InduLink.Abstractions;InduLink.Runtime;InduLink.Protocols.Ads;InduLink.Protocols.Ads.Router;InduLink.Storage" />
    <Reference Include="@(InduLinkLibrary)">
      <HintPath>$(InduLinkLibraryDirectory)\%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 在构建和设计时的引用解析前检查 DLL；缺文件不阻断 NuGet 还原。 -->
  <Target Name="ValidateInduLinkLibraries" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_MissingInduLinkLibrary Include="@(InduLinkLibrary)" Condition="!Exists('$(InduLinkLibraryDirectory)\%(Identity).dll')" />
    </ItemGroup>
    <Error Condition="'@(_MissingInduLinkLibrary)' != ''" Code="INDULINK001" File="$(MSBuildProjectFullPath)" Text="缺少所需 DLL：@(_MissingInduLinkLibrary -> '%(Identity).dll', '、')。请放入 $(InduLinkLibraryDirectory)。文件清单及来源见 lib\README.md。" />
  </Target>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
