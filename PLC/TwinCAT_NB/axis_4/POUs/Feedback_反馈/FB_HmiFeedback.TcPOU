<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HmiFeedback" Id="{163C991F-F4DB-48D4-8E9A-70F780C7DC8D}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HmiFeedback
// 在 MAIN 的四个基础轴块之后每扫描调用，只发布状态，不写任何轴命令。
// switch 的机器监控和手动轴反馈使用同一批实际 NC/功能块结果。
VAR
    tmHeartbeat : TON; // PLC 自复位心跳定时器，每约 500 ms 推进一次只读监控心跳。
    udiFault : UDINT; // 本扫描选出的完整故障码；轨迹组优先，其次为第一根故障轴。
    nFaultAxis : UINT; // 故障来源轴号：0 为组故障或无故障，1～4 为对应轴。
    i : INT; // 汇总四轴配置、就绪及故障的循环轴号，范围 1～4。
    Config : ST_AxisConfig; // 循环检查当前轴的配置副本；只读校验，不修改设备参数。
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[// 1. 自复位 TON 每约 500 ms 产生一个扫描周期的 Q，不依赖上位机写入。
// 心跳始终更新，不能因待机/故障而停住，否则 switch 会认为反馈已过期。
tmHeartbeat(IN := NOT tmHeartbeat.Q, PT := T#500MS);
IF tmHeartbeat.Q THEN
    IF GVL_HMI.stMonitor.udiHeartbeat = UDINT#4294967295 THEN
        GVL_HMI.stMonitor.udiHeartbeat := 0;
    ELSE
        GVL_HMI.stMonitor.udiHeartbeat := GVL_HMI.stMonitor.udiHeartbeat + 1;
    END_IF
END_IF

// 2. 控制权取仲裁结果，模式按实际状态发布；HMI 只读反馈。
GVL_HMI.stMonitor.nControlOwner := GVL_control.nOwner;
// 模式由实际控制端和轨迹占用决定，不再通过 GVL_pc 中转。
IF GVL_control.nOwner = 0 THEN GVL_HMI.stMonitor.nControlMode := 0;
ELSIF GVL_motion.xBusy THEN GVL_HMI.stMonitor.nControlMode := 2;
ELSE GVL_HMI.stMonitor.nControlMode := 1;
END_IF

// 3. 组故障优先，其次取 Axis1..4 的第一个轴故障。每扫描重算，故障消失就清零。
udiFault := 0;
nFaultAxis := 0;
IF GVL_motion.xError THEN
    udiFault := GVL_motion.udiErrorId;
    nFaultAxis := GVL_motion.nFaultAxis;
ELSIF GVL_axis.Axis1.xError THEN
    udiFault := GVL_axis.Axis1.udiErrorId; nFaultAxis := 1;
ELSIF GVL_axis.Axis2.xError THEN
    udiFault := GVL_axis.Axis2.udiErrorId; nFaultAxis := 2;
ELSIF GVL_axis.Axis3.xError THEN
    udiFault := GVL_axis.Axis3.udiErrorId; nFaultAxis := 3;
ELSIF GVL_axis.Axis4.xError THEN
    udiFault := GVL_axis.Axis4.udiErrorId; nFaultAxis := 4;
END_IF
// 有错误标志但源块尚无错误码时，用 1010 表示轴/控制错误，避免“故障且码为零”。
IF (GVL_motion.xError OR (nFaultAxis <> 0)) AND (udiFault = 0) THEN udiFault := 1010; END_IF
GVL_HMI.udiDetailedFaultCode := udiFault;
GVL_HMI.nFaultAxis := nFaultAxis;
IF udiFault > UDINT#65535 THEN
    GVL_HMI.stMonitor.uiWaveFaultCode := UINT#65535;
ELSE
    GVL_HMI.stMonitor.uiWaveFaultCode := UDINT_TO_UINT(udiFault);
END_IF

// 4. 内部轨迹状态不直接当作页面状态：例如内部 30 对应页面“2 造波中”。
// 停车时先显示“停止中”，实际退出后有故障则显示故障，不把停止请求发送成功当作完成。
IF (GVL_motion.nState = 40) OR (GVL_motion.nState = 50)
    OR (GVL_motion.nState = 60) OR (GVL_motion.nState = 70) THEN
    GVL_HMI.stMonitor.nWaveState := 4;
ELSIF udiFault <> 0 THEN
    GVL_HMI.stMonitor.nWaveState := 7;
ELSIF GVL_motion.nState = 30 THEN
    GVL_HMI.stMonitor.nWaveState := 2;
ELSIF (GVL_motion.nState = 5) OR (GVL_motion.nState = 10)
    OR (GVL_motion.nState = 15) OR (GVL_motion.nState = 20) THEN
    GVL_HMI.stMonitor.nWaveState := 1;
ELSIF GVL_motion.xStopped THEN
    GVL_HMI.stMonitor.nWaveState := 5;
ELSIF GVL_motion.xDone THEN
    GVL_HMI.stMonitor.nWaveState := 6;
ELSE
    GVL_HMI.stMonitor.nWaveState := 0;
END_IF

// 5. 保留原始轨迹诊断；本次只接手动和监控，不新增上位机自动造波写入入口。
GVL_HMI.nTrajectoryState := GVL_motion.nState;
GVL_HMI.nCurrentPoint := GVL_motion.nCurrentPoint;
GVL_HMI.nLoadedCount := GVL_motion.nLoadedCount;
GVL_HMI.nPointCount := GVL_motion.nPointCount;
GVL_HMI.xDataReady := GVL_motion.xDataReady;
GVL_HMI.xTrajectoryBusy := GVL_motion.xBusy;

// 6. 整块接口固定布局，轴反馈从本扫描实际结果集中发布。
// 普通 ADS 读取不声明为跨任务原子快照。
GVL_HMI.stMonitor.nVersion := 4;
GVL_HMI.stMonitor.udiProgramVersion := 2026102301;
GVL_HMI.stMonitor.nBehaviorVersion := 1;
GVL_HMI.stMonitor.nFaultAxis := GVL_motion.nFaultAxis;
GVL_HMI.stMonitor.nFaultSource := GVL_motion.nFaultSource;
GVL_HMI.stMonitor.nFaultState := GVL_motion.nFaultState;
GVL_HMI.stMonitor.udiCleanupErrorId := GVL_motion.udiCleanupErrorId;
GVL_HMI.stMonitor.nByteSize := SIZEOF(GVL_HMI.stMonitor);
GVL_HMI.stMonitor.Axis1.lrActualPosition := GVL_axis.Axis1.lrActualPosition;
GVL_HMI.stMonitor.Axis1.lrSpeed := GVL_axis.Axis1.lrSpeed;
GVL_HMI.stMonitor.Axis1.xHomed := GVL_axis.Axis1.xHomed;
GVL_HMI.stMonitor.Axis1.xError := GVL_axis.Axis1.xError;
GVL_HMI.stMonitor.Axis1.xPositiveLimit := GVL_axis.Axis1.xPositiveLimit;
GVL_HMI.stMonitor.Axis1.xNegativeLimit := GVL_axis.Axis1.xNegativeLimit;
GVL_HMI.stMonitor.Axis1.xOriginSignal := GVL_axis.Axis1.xOriginSignal;
GVL_HMI.stMonitor.Axis1.xEnabled := GVL_axis.Axis1.xEnabled;
GVL_HMI.stMonitor.Axis2.lrActualPosition := GVL_axis.Axis2.lrActualPosition;
GVL_HMI.stMonitor.Axis2.lrSpeed := GVL_axis.Axis2.lrSpeed;
GVL_HMI.stMonitor.Axis2.xHomed := GVL_axis.Axis2.xHomed;
GVL_HMI.stMonitor.Axis2.xError := GVL_axis.Axis2.xError;
GVL_HMI.stMonitor.Axis2.xPositiveLimit := GVL_axis.Axis2.xPositiveLimit;
GVL_HMI.stMonitor.Axis2.xNegativeLimit := GVL_axis.Axis2.xNegativeLimit;
GVL_HMI.stMonitor.Axis2.xOriginSignal := GVL_axis.Axis2.xOriginSignal;
GVL_HMI.stMonitor.Axis2.xEnabled := GVL_axis.Axis2.xEnabled;
GVL_HMI.stMonitor.Axis3.lrActualPosition := GVL_axis.Axis3.lrActualPosition;
GVL_HMI.stMonitor.Axis3.lrSpeed := GVL_axis.Axis3.lrSpeed;
GVL_HMI.stMonitor.Axis3.xHomed := GVL_axis.Axis3.xHomed;
GVL_HMI.stMonitor.Axis3.xError := GVL_axis.Axis3.xError;
GVL_HMI.stMonitor.Axis3.xPositiveLimit := GVL_axis.Axis3.xPositiveLimit;
GVL_HMI.stMonitor.Axis3.xNegativeLimit := GVL_axis.Axis3.xNegativeLimit;
GVL_HMI.stMonitor.Axis3.xOriginSignal := GVL_axis.Axis3.xOriginSignal;
GVL_HMI.stMonitor.Axis3.xEnabled := GVL_axis.Axis3.xEnabled;
GVL_HMI.stMonitor.Axis4.lrActualPosition := GVL_axis.Axis4.lrActualPosition;
GVL_HMI.stMonitor.Axis4.lrSpeed := GVL_axis.Axis4.lrSpeed;
GVL_HMI.stMonitor.Axis4.xHomed := GVL_axis.Axis4.xHomed;
GVL_HMI.stMonitor.Axis4.xError := GVL_axis.Axis4.xError;
GVL_HMI.stMonitor.Axis4.xPositiveLimit := GVL_axis.Axis4.xPositiveLimit;
GVL_HMI.stMonitor.Axis4.xNegativeLimit := GVL_axis.Axis4.xNegativeLimit;
GVL_HMI.stMonitor.Axis4.xOriginSignal := GVL_axis.Axis4.xOriginSignal;
GVL_HMI.stMonitor.Axis4.xEnabled := GVL_axis.Axis4.xEnabled;

// 自动页从同一帧读取确认进度和准备条件，不用写成功冒充就绪。
GVL_HMI.stMonitor.nTrajectoryState := GVL_motion.nState;
GVL_HMI.stMonitor.nReceivedCount := GVL_motion.nReceivedCount;
GVL_HMI.stMonitor.nLoadedCount := GVL_motion.nLoadedCount;
GVL_HMI.stMonitor.nPointCount := GVL_motion.nPointCount;
GVL_HMI.stMonitor.nCurrentPoint := GVL_motion.nCurrentPoint;
GVL_HMI.stMonitor.udiReceivedSequence := GVL_motion.udiReceivedSequence;
GVL_HMI.stMonitor.udiAcceptedSequence := GVL_motion.udiAcceptedSequence;
GVL_HMI.stMonitor.udiErrorId := GVL_motion.udiErrorId;
GVL_HMI.stMonitor.nUploadStation := GVL_motion.nUploadStation;
GVL_HMI.stMonitor.xUploadBusy := GVL_motion.xUploadBusy;
GVL_HMI.stMonitor.xDataReady := GVL_motion.xDataReady;
GVL_HMI.stMonitor.xTrajectoryBusy := GVL_motion.xBusy;
GVL_HMI.stMonitor.xRunning := GVL_motion.xRunning;
GVL_HMI.stMonitor.xDone := GVL_motion.xDone;
GVL_HMI.stMonitor.xError := GVL_motion.xError;
GVL_HMI.stMonitor.xStopped := GVL_motion.xStopped;
GVL_HMI.stMonitor.xAxesStopped := GVL_axis.Axis1.xStopped AND GVL_axis.Axis2.xStopped
    AND GVL_axis.Axis3.xStopped AND GVL_axis.Axis4.xStopped;
GVL_HMI.stMonitor.xMotionPermit := GVL_motion.xMotionPermit;
GVL_HMI.stMonitor.xConfigValid := TRUE;
// 未使能轴的 NC 状态为 Disabled；上传和自动使能前也应允许已停稳的空闲轴。
GVL_HMI.stMonitor.xAxesIdle := GVL_HMI.stMonitor.xAxesStopped
    AND NOT GVL_axis.Axis1.xBusy AND NOT GVL_axis.Axis2.xBusy
    AND NOT GVL_axis.Axis3.xBusy AND NOT GVL_axis.Axis4.xBusy;
GVL_HMI.stMonitor.xAxisFault := GVL_axis.Axis1.xError OR GVL_axis.Axis2.xError
    OR GVL_axis.Axis3.xError OR GVL_axis.Axis4.xError;
FOR i := 1 TO 4 DO
    Config := GVL_motion.aConfig[i];
    GVL_HMI.stMonitor.xConfigValid := GVL_HMI.stMonitor.xConfigValid
        AND (Config.lrMinPosition >= -1.0E12) AND (Config.lrMaxPosition <= 1.0E12)
        AND (Config.lrMinPosition < Config.lrMaxPosition)
        AND (Config.lrMaxVelocity > 0) AND (Config.lrMaxVelocity < 1.0E12)
        AND (Config.lrMaxAcceleration > 0) AND (Config.lrMaxAcceleration < 1.0E12)
        AND (Config.lrStopDeceleration > 0) AND (Config.lrStopDeceleration <= Config.lrMaxAcceleration)
        AND (Config.lrInitVelocity > 0) AND (Config.lrInitVelocity <= Config.lrMaxVelocity)
        AND (Config.lrStartTolerance >= 0) AND (Config.lrStartTolerance < 1.0E12);
    GVL_HMI.stMonitor.xAxesIdle := GVL_HMI.stMonitor.xAxesIdle
        AND (GVL_sy.axis[i].Status.StandStill OR GVL_sy.axis[i].Status.Disabled)
        AND NOT GVL_sy.axis[i].Status.Homing
        AND NOT GVL_sy.axis[i].Status.Stopping AND NOT GVL_sy.axis[i].Status.ExtSetPointGenEnabled
        AND NOT GVL_sy.axis[i].Status.IoDataInvalid;
    GVL_HMI.stMonitor.xAxisFault := GVL_HMI.stMonitor.xAxisFault
        OR GVL_sy.axis[i].Status.Error OR GVL_sy.axis[i].Status.IoDataInvalid;
END_FOR
]]></ST></Implementation>
  </POU>
</TcPlcObject>
