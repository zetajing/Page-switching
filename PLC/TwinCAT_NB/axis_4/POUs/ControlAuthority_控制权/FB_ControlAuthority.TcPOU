<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ControlAuthority" Id="{9270AB05-B370-44A3-9D02-4FCF92386078}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ControlAuthority
VAR_INPUT
    xMotionBusy : BOOL; // 含实际运动、轨迹占用、轴块 Busy，不仅看造波运行位。
    xFeedbackInvalid : BOOL; // I/O 故障只在轴仍使能时阻止交接，未使能时可申请和释放。
END_VAR
VAR
    nOwner : UINT; // 私有持有者，启动 0；GVL_control.nOwner 只是只读发布副本。
    nOldOwner : UINT; // 本扫描开始时的持有站，用于识别本扫描是否发生控制权交接。
    xOwnerLost : BOOL; // 持有站失联锁存；恢复心跳不恢复旧授权，停稳后才清旧持有者。
    xResetCommands : BOOL; // 撤权后同扫描重新授予原站，也必须清旧命令。
    xLocked : BOOL; // 申请、释放、失联退出统一使用这一份运动联锁。
    axSeenHeartbeat : ARRAY[1..3] OF BOOL; // 各站自启动以来是否出现过心跳变化，索引 1～3 对应站号。
    aLastHeartbeat : ARRAY[1..3] OF UDINT; // 各站上一扫描心跳值，仅用于判断心跳是否变化，不要求连续递增。
    aTimeout : ARRAY[1..3] OF TON; // 各站心跳超时定时器；连续 3 秒不变化判离线。
    aEmpty : ARRAY[1..4] OF ST_AxisCommand; // 四轴全零命令模板，交接时清各站旧命令，防止动作重放。
    i : INT; // 站点循环索引，范围 1～3。
    j : INT; // 当前站手动命令的轴索引，范围 1～4。
    nReply : UINT; // 本次仲裁应答码：1 成功、2 锁定、4 离线、5 非持有者、6 优先级、7 无效请求。
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[nOldOwner := nOwner;
xResetCommands := FALSE;
FOR i := 1 TO 3 DO
    IF GVL_control.aStation[i].udiHeartbeat <> aLastHeartbeat[i] THEN axSeenHeartbeat[i] := TRUE; END_IF
    aTimeout[i](IN := GVL_control.aStation[i].udiHeartbeat = aLastHeartbeat[i], PT := T#3S);
    aLastHeartbeat[i] := GVL_control.aStation[i].udiHeartbeat;
    GVL_control.aStation[i].xOnline := axSeenHeartbeat[i] AND NOT aTimeout[i].Q;
END_FOR
// 纯软件申请：三站均可申请，由在线状态、运行锁和站号优先级决定结果。

// 一份联锁：有运动占用，或 I/O 故障且轴仍使能时，禁止交接。
// I/O 故障本身不锁控制权；基础轴块仍独立禁止故障下的新使能和运动。
xLocked := xMotionBusy OR (xFeedbackInvalid AND (GVL_axis.Axis1.xEnabled
    OR GVL_axis.Axis2.xEnabled OR GVL_axis.Axis3.xEnabled OR GVL_axis.Axis4.xEnabled));
IF nOwner <> 0 THEN
    IF NOT GVL_control.aStation[nOwner].xOnline THEN xOwnerLost := TRUE; END_IF
    // 已接收但尚未进入 NC 运动的命令也锁住交接，覆盖“申请与启动同一扫描”的窗口。
    // 失联后忽略旧邮箱中的保持命令，让实际停车完成后可以退出，不会永远卡住 Owner。
    IF NOT xOwnerLost THEN
        FOR j := 1 TO 4 DO
            xLocked := xLocked OR GVL_control.aStation[nOwner].aAxis[j].jogz
                OR GVL_control.aStation[nOwner].aAxis[j].jogf
                OR GVL_control.aStation[nOwner].aAxis[j].gohome;
        END_FOR
        xLocked := xLocked OR GVL_control.aStation[nOwner].xWaveSession
            OR ((GVL_motion.nCommandStation = nOwner) AND GVL_motion.xStart);
    END_IF
    // 失联先撤命令；退出条件满足后清旧 Owner。恢复心跳不会恢复旧授权。
    IF NOT xLocked AND xOwnerLost THEN
        nOwner := 0;
        xOwnerLost := FALSE;
        xResetCommands := TRUE;
    END_IF
END_IF

// 同一扫描先处理释放，再按 1/2/3 的优先级处理申请；被拒绝的请求立即应答，不排队自动接管。
FOR i := 1 TO 3 DO
    IF (GVL_control.aStation[i].udiRequestSequence <> 0)
        AND (GVL_control.aStation[i].udiRequestSequence <> GVL_control.aStation[i].udiAckSequence)
        AND (GVL_control.aStation[i].nAction = 2) THEN
        nReply := F_ControlDecision(nOwner := nOwner, nStation := INT_TO_UINT(i), nAction := 2,
            xLocked := xLocked, xOnline := GVL_control.aStation[i].xOnline);
        IF nReply = 1 THEN nOwner := 0; xResetCommands := TRUE; END_IF
        GVL_control.aStation[i].nResult := nReply;
        GVL_control.aStation[i].udiAckSequence := GVL_control.aStation[i].udiRequestSequence;
    END_IF
END_FOR
FOR i := 1 TO 3 DO
    IF (GVL_control.aStation[i].udiRequestSequence <> 0)
        AND (GVL_control.aStation[i].udiRequestSequence <> GVL_control.aStation[i].udiAckSequence) THEN
        nReply := F_ControlDecision(nOwner := nOwner, nStation := INT_TO_UINT(i),
            nAction := GVL_control.aStation[i].nAction, xLocked := xLocked,
            xOnline := GVL_control.aStation[i].xOnline);
        IF (nReply = 1) AND (GVL_control.aStation[i].nAction = 1) THEN
            nOwner := INT_TO_UINT(i);
        END_IF
        GVL_control.aStation[i].nResult := nReply;
        GVL_control.aStation[i].udiAckSequence := GVL_control.aStation[i].udiRequestSequence;
    END_IF
END_FOR
GVL_control.xOwnerChanged := (nOwner <> nOldOwner) OR xResetCommands;
IF GVL_control.xOwnerChanged THEN
    // 清所有站点的旧运动命令，新持有者必须重新下发，不能继承旧按钮或排队动作。
    FOR i := 1 TO 3 DO
        GVL_control.aStation[i].aAxis := aEmpty;
        GVL_control.aStation[i].xWaveSession := FALSE;
    END_FOR
    // 新控制端不得继承上一个站的轨迹触发位。
    GVL_motion.xStart := FALSE;
    GVL_motion.xUpload := FALSE;
    GVL_motion.xAssemble := FALSE;
    GVL_motion.xClear := FALSE;
    GVL_motion.xReset := FALSE;
    GVL_motion.xStop := FALSE;
END_IF
IF nOwner = 0 THEN xOwnerLost := FALSE; END_IF
GVL_control.xCanCommand := FALSE;
FOR i := 1 TO 3 DO
    GVL_control.aStation[i].xGranted := (nOwner = i) AND NOT xOwnerLost AND GVL_control.aStation[i].xOnline;
    GVL_control.xCanCommand := GVL_control.xCanCommand OR GVL_control.aStation[i].xGranted;
END_FOR
GVL_control.nOwner := nOwner;
GVL_control.xLocked := xLocked;
GVL_control.xCanRelease := (nOwner <> 0) AND NOT xLocked AND NOT xOwnerLost;
GVL_control.xStopOwner := xOwnerLost;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
