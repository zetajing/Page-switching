<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_AxisConfig" Id="{7dd9332e-c8fa-41bf-891c-704d4a4b07e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AxisConfig
// 轴配置单独在此填写，直接写入全局四轴参数。
// 当前值仅用于虚拟轴调试；接实机时须按实际 NC 单位、行程和动态参数重新配置。
VAR
    i : INT; // 四轴配置下标，1～4；复用已有状态反馈，不另存初始化或空闲标志。
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 空闲反馈来自上一扫描；当前扫描的运动锁和 I/O 有效性由 MAIN 的 A02 更新。
// 等待有效停稳、轴块/轨迹/拼表空闲，以及点动、回原、轨迹启动请求释放。
IF GVL_HMI.stMonitor.xAxesIdle AND NOT GVL_control.xLocked AND NOT GVL_control.xFeedbackInvalid
    AND NOT GVL_motion.xBusy AND NOT GVL_motion.xUploadBusy AND NOT GVL_motion.xStart
    // 再直接确认当前 NC 停稳，避免使用上扫描空闲值时漏掉新出现的无效速度。
    AND (GVL_sy.axis[1].Status.StandStill OR GVL_sy.axis[1].Status.Disabled)
    AND (GVL_sy.axis[2].Status.StandStill OR GVL_sy.axis[2].Status.Disabled)
    AND (GVL_sy.axis[3].Status.StandStill OR GVL_sy.axis[3].Status.Disabled)
    AND (GVL_sy.axis[4].Status.StandStill OR GVL_sy.axis[4].Status.Disabled)
    AND (ABS(GVL_sy.axis[1].NcToPlc.ActVelo) <= 0.000001)
    AND (ABS(GVL_sy.axis[2].NcToPlc.ActVelo) <= 0.000001)
    AND (ABS(GVL_sy.axis[3].NcToPlc.ActVelo) <= 0.000001)
    AND (ABS(GVL_sy.axis[4].NcToPlc.ActVelo) <= 0.000001) THEN
    FOR i := 1 TO 4 DO
        // 当前四根虚拟轴使用相同参数，空闲时直接应用本块数值，已有旧值也能更新。
        // 200/12000 按本次虚拟轴调试确认；不作为实机速度、加速度能力。
        GVL_motion.aConfig[i].lrMinPosition := -200;
        GVL_motion.aConfig[i].lrMaxPosition := 200;
        GVL_motion.aConfig[i].lrMaxVelocity := 200;
        GVL_motion.aConfig[i].lrMaxAcceleration := 12000;
        GVL_motion.aConfig[i].lrStopDeceleration := 100;
        GVL_motion.aConfig[i].lrInitVelocity := 10;
        GVL_motion.aConfig[i].lrStartTolerance := 10;
    END_FOR
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
