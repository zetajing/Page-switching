<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_motion" Id="{ACEE1007-EA71-4EA2-9D01-583F37467912}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// ADS 协议：上位机写命令/数据，PLC 写反馈；状态字段只供上位机读取。
// PC 连续提交各段，全部下发后用 xAssemble 请求 PLC 拼表；xDataReady 后才允许启动。
// xUpload/xAssemble/xClear/xStart/xReset 都需回 FALSE 后再产生下一次上升沿。
VAR_GLOBAL
    // 运行许可由 MAIN 每扫描写入；当前仅用于虚拟轴调试。
    xMotionPermit : BOOL; // 实机改接安全继电器允许反馈，不代替硬件安全回路。
    axPositiveLimit : ARRAY[1..4] OF BOOL; // 四轴正向硬限位输入，索引为轴号 1～4，TRUE 表示触发。
    axNegativeLimit : ARRAY[1..4] OF BOOL; // 四轴负向硬限位输入，索引为轴号 1～4，TRUE 表示触发。
    axHomeSensor : ARRAY[1..4] OF BOOL; // 四轴原点开关输入，索引为轴号 1～4，传给 NC 标准回零校准凸轮。
    // 四轴配置只在 FB_AxisConfig 中填写，手动、反馈和轨迹均读取此数组。
    aConfig : ARRAY[1..4] OF ST_AxisConfig; // 单位跟随 NC；空闲时由配置块直接更新，运动期间保持。

    // 以下为上位机写入的轨迹命令与点位；nUploadStation、xStopped 两项由 PLC 写、上位机只读。
    nCommandStation : UINT; // 上位机命令来源，必须等于有效 Owner；不是授权本身。
    nUploadStation : UINT; // PLC 锁存的上传所属站，只读。
    xStopped : BOOL; // 人工停止完成；不同于自然完成 xDone 或故障。
    // 参考旧工程的独立分段区：21 段、每段四轴、每轴最多 100000 个 LREAL 点。
    // 下标依次为 [段号, 轴号, 段内点号]；已提交段禁止覆盖，全部下发后统一拼接。
    aUpload : ARRAY[0..20, 1..4, 0..99999] OF LREAL; // 上位机写入的独立位置段：[段0～20,轴1～4,段内点0～99999]，数值单位跟随 NC。
    nPointCount : UDINT; // 整条轨迹总点数，4..2100000。
    nSampleTimeUs : UINT := 2000; // 单位微秒，目前仅接受 2000。
    udiUploadSequence : UDINT; // 整条轨迹使用同一个非零序号。
    nUploadOffset : UDINT; // 本段全局偏移，必须等于 nReceivedCount，段号=偏移/100000。
    nUploadCount : UDINT; // 非末段必须 100000 点；末段为总点数的剩余量。
    xUpload : BOOL; // 四轴本段数据写完后上升沿登记，只确认接收，不拼表。
    xAssemble : BOOL; // 全部段确认后上升沿请求统一拼表；拼接期间所有段保持不变。
    xClear : BOOL; // 空闲时上升沿清除整条位置表的就绪状态，开始新一轮上传。
    xStart : BOOL; // 完整位置表到齐后，上升沿启动。
    xStop : BOOL; // 保持型组停止，启动前必须释放。
    xReset : BOOL; // 清组故障；各轴故障用 Axis1..4.reset。
    udiHeartbeat : UDINT; // 校验/运动期间 1 秒不变化则联停。

    // 以下字段由 PLC 写，上位机只读。
    nReceivedCount : UDINT; // 已登记的下发点数，也是下一段允许的起始偏移；不代表已拼接。
    udiReceivedSequence : UDINT; // 已登记各段所属轨迹序号，清表后为 0。
    xUploadBusy : BOOL; // 全部下发后的统一拼表正在执行，不表示 PC 正在写 ADS。
    nLoadedCount : UDINT; // 四轴均已拼入完整表的点数；下发期间始终为 0。
    xDataReady : BOOL; // 全部段已统一拼接完成，不表示已校验或已定位到首点。
    xBusy : BOOL; // 校验、首点定位、执行和退出期间占用轴控制。
    xRunning : BOOL; // 状态 30，首点定位及减速不算正常取点运行。
    xDone : BOOL; // 正常完成后保持，清表/复位/新启动时清除。
    xError : BOOL; // 组故障保持位，需确认退出和静止后复位。
    udiErrorId : UDINT; // 首次故障的程序诊断码或 MC 原始 ErrorID，详见说明文档。
    nFaultAxis : UINT; // 首次故障轴 1..4；组故障或无故障为 0，复位时清除。
    nFaultSource : UINT; // 首次故障来源：1许可/2控制权/3使能/4单轴停止/5手动冲突/6限位，7..20见故障说明。
    nFaultState : UINT; // 首次故障发生阶段；故障退出期间保持，不能用当前停车阶段替代。
    udiCleanupErrorId : UDINT; // 首个停车、关闭或退出错误，保留原始 udiErrorId。
    nState : UINT; // 对应轨迹块 CASE 的 0/5/10/15/20/30/40/50/60/70/90。
    nCurrentPoint : UDINT; // 最近送出的点号，0 起始。
    udiAcceptedSequence : UDINT; // 已进入首点定位的轨迹序号，不能重复执行。
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
