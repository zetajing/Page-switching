<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_HMI" Id="{68E73C03-8702-4554-A9D6-BEDDB66BF83B}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // 整块只读监控接口；由 FB_HmiFeedback 在轴块执行后发布。
    stMonitor : ST_MachineMonitor;
    // 保留完整故障码及轨迹诊断；全部由 PLC 发布，上位机只读。
    udiDetailedFaultCode : UDINT; // 完整错误码，不丢失高 16 位。
    nFaultAxis : UINT; // 0 为组故障或无错误；1..4 为对应轴的首个错误。
    nTrajectoryState : UINT; // 轨迹块内部 nState，区别于上述页面状态编码。
    nCurrentPoint : UDINT;
    nLoadedCount : UDINT;
    nPointCount : UDINT;
    xDataReady : BOOL;
    xTrajectoryBusy : BOOL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
