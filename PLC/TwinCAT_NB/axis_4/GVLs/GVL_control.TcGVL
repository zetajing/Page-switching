<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_control" Id="{77D2CFF4-88AE-4C20-BC1C-12AABEE26C56}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // 新三站协议编码：1 造波控制室，2 拖车本地，3 远程操作室；数字小优先级高。
    // 各站只写自己的请求、心跳和手动命令；应答与授权结果由 PLC 写。
    aStation : ARRAY[1..3] OF ST_ControlStation; // 三站独立邮箱；各站写自己的请求/心跳/命令，PLC 写应答与授权反馈。
    // 纯软件申请，不使用现场主控选择位；PLC 按心跳、运行锁及优先级授予控制权。
    // 以下由仲裁块写，任何上位机都不能直接写 Owner 来取得权限。
    nOwner : UINT; // PLC 发布的持有站：0 未分配，1 控制室、2 拖车本地、3 远程室；上位机只读。
    xLocked : BOOL; // 统一交接锁：运动、待执行运动命令，或 I/O 故障下轴仍使能。
    xCanRelease : BOOL; // 由 Owner 和 xLocked 推导，保留此反馈供已有上位机兼容。
    xFeedbackInvalid : BOOL; // 任一轴 NC I/O 无效；单独提示，基础轴块禁止新使能/运动。
    xCanCommand : BOOL; // PLC 发布的当前持有站命令许可；需持有站在线且未失联锁存。
    xOwnerChanged : BOOL; // 本扫描发生交接或撤权重授的标志，用于清旧命令、阻止同扫描重放。
    xStopOwner : BOOL; // 失联后撤销命令并停车，保持旧 Owner 直到停稳。
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
