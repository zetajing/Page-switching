<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_control" Id="{77D2CFF4-88AE-4C20-BC1C-12AABEE26C56}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // 新三站协议编码：1 造波控制室，2 拖车本地，3 远程操作室；数字小优先级高。
    aStation : ARRAY[1..3] OF ST_ControlStation;
    // 纯软件申请，不使用现场主控选择位；PLC 按心跳、运行锁及优先级授予控制权。
    // 以下由仲裁块写，任何上位机都不能直接写 Owner 来取得权限。
    nOwner : UINT;
    xLocked : BOOL; // 运行/运动命令尚未退出，禁止申请接管和释放。
    xFeedbackInvalid : BOOL; // 任一轴 NC I/O 无效；无主且无运动占用时可申请后复位，禁止使能/运动。
    xCanCommand : BOOL;
    xOwnerChanged : BOOL;
    xStopOwner : BOOL; // 失联后撤销命令并停车，保持旧 Owner 直到停稳。
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
