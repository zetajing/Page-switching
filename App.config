<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 本站身份用于选择 PLC 站点邮箱，不代表授权；保存后重启生效。WaveControlRoom / TowingLocal / RemoteControlRoom，留空禁止命令。 -->
    <add key="ControlStationIdentity" value="" />
    <!-- 操作日志目录：留空沿用 %LOCALAPPDATA%\PageSwitching\Operations；支持绝对路径、相对程序目录的路径和环境变量。 -->
    <add key="OperationLogDirectory" value="" />
    <!-- TwinCAT_NB 四轴符号映射；部署后先核对 NC 轴/物理方向/单位及运动许可。 -->
    <add key="AdsAmsNetId" value="192.168.0.55.1.1" />
    <add key="AdsPort" value="851" />
    <add key="AdsConnectTimeoutMs" value="10000" />
    <add key="AdsOperationTimeoutMs" value="5000" />
    <add key="AdsRefreshIntervalMs" value="100" />
    <!-- 自动页只读监控接口；由 PLC 新增 GVL_HMI 并持续更新，定义见 docs/PlcMonitoringContract.md。 -->
    <!-- 单次 ADS 请求为 1000 ms；整轮结构体读取限时 3000 ms，首次获取句柄，后续直接读取。 -->
    <add key="AdsMonitorRefreshTimeoutMs" value="3000" />
    <!-- ST_MachineMonitor，版本 2 / 104 字节；需先部署配套 PLC。 -->
    <add key="AdsMonitorSnapshot" value="GVL_HMI.stMonitor" />
    <!-- 73 电脑使用系统 Router，保持 false；113 电脑没有 TwinCAT Router，启用后使用下列配置。
         两台电脑的连接及回程路由说明见 docs/AdsConnectionGuide.md。 -->
    <add key="AdsTcpRouterEnabled" value="false" />
    <add key="AdsTcpRouterName" value="PageSwitchingRouter" />
    <add key="AdsTcpRouterLocalNetId" value="192.168.1.113.1.1" />
    <add key="AdsTcpRouterTcpPort" value="48898" />
    <add key="AdsTcpRouterLoopbackIp" value="127.0.0.1" />
    <add key="AdsTcpRouterLoopbackPort" value="48898" />
    <add key="AdsTcpRouterRemoteName" value="WaveMakerPlc" />
    <add key="AdsTcpRouterRemoteAddress" value="192.168.1.73" />
    <add key="AdsTcpRouterRemoteNetId" value="192.168.0.55.1.1" />
    <!-- 浪高仪 TCP 参数：默认值沿用旧上位机连接窗口。 -->
    <add key="WaveHeightMeterIp" value="192.168.0.7" />
    <add key="WaveHeightMeterPort" value="502" />
    <add key="WaveHeightMeterSampleRateHz" value="50" />
    <add key="WaveHeightMeterSampleCount" value="4096" />
    <add key="AxisUnit" value="°" />
    <add key="AxisMinimum" value="-20" />
    <add key="AxisMaximum" value="20" />

    <!-- 数据库：只用于运行日志和操作追溯，不参与 PLC 实时控制。 -->
    <add key="DatabaseEnabled" value="false" />
    <add key="DatabaseProvider" value="SQL Server" />
    <add key="DatabaseConnectionString" value="Server=localhost;Database=WaveControl;Integrated Security=True;TrustServerCertificate=True" />
    <add key="DatabaseUserName" value="" />
    <add key="DatabasePassword" value="" />

    <!-- 波形生成方案：ExternalExe=WFast.exe，WaveMaker=内置算法，LegacyExe=旧WP-5-6.exe。 -->
    <add key="WaveGeneratorMode" value="ExternalExe" />
    <!-- 选择 ExternalExe 时填写 WFast.exe 路径；选择 WaveMaker 时可留空。 -->
    <add key="WaveGeneratorPath" value="" />
    <!-- 旧波形生成、修正和分析EXE的目录，在系统配置中设置。 -->
    <add key="WaveProgramDirectory" value="" />

    <!-- 命令地址的 {station} 由启动时的本站身份解析为 1/2/3；未配置身份禁止命令写入。 -->
    <!-- xEnabled 为使能成功，xMotorRun 为实际运动；jogz 为 NC 正向，jogf 为 NC 负向。 -->
    <!-- 轴 1 控制命令：仅写本站邮箱；四轴反馈统一读取 AdsMonitorSnapshot。 -->
    <add key="AdsAxis1EnableCommand" value="GVL_control.aStation[{station}].aAxis[1].xStart" />
    <add key="AdsAxis1ResetAlarmCommand" value="GVL_control.aStation[{station}].aAxis[1].reset" />
    <add key="AdsAxis1HomeCommand" value="GVL_control.aStation[{station}].aAxis[1].gohome" />
    <add key="AdsAxis1StopCommand" value="GVL_control.aStation[{station}].aAxis[1].xStop" />
    <add key="AdsAxis1JogSpeedCommand" value="GVL_control.aStation[{station}].aAxis[1].lrJogSpeed" />
    <add key="AdsAxis1JogPositiveCommand" value="GVL_control.aStation[{station}].aAxis[1].jogz" />
    <add key="AdsAxis1JogNegativeCommand" value="GVL_control.aStation[{station}].aAxis[1].jogf" />

    <!-- 轴 2 控制命令：仅写本站邮箱；四轴反馈统一读取 AdsMonitorSnapshot。 -->
    <add key="AdsAxis2EnableCommand" value="GVL_control.aStation[{station}].aAxis[2].xStart" />
    <add key="AdsAxis2ResetAlarmCommand" value="GVL_control.aStation[{station}].aAxis[2].reset" />
    <add key="AdsAxis2HomeCommand" value="GVL_control.aStation[{station}].aAxis[2].gohome" />
    <add key="AdsAxis2StopCommand" value="GVL_control.aStation[{station}].aAxis[2].xStop" />
    <add key="AdsAxis2JogSpeedCommand" value="GVL_control.aStation[{station}].aAxis[2].lrJogSpeed" />
    <add key="AdsAxis2JogPositiveCommand" value="GVL_control.aStation[{station}].aAxis[2].jogz" />
    <add key="AdsAxis2JogNegativeCommand" value="GVL_control.aStation[{station}].aAxis[2].jogf" />

    <!-- 轴 3 控制命令：仅写本站邮箱；四轴反馈统一读取 AdsMonitorSnapshot。 -->
    <add key="AdsAxis3EnableCommand" value="GVL_control.aStation[{station}].aAxis[3].xStart" />
    <add key="AdsAxis3ResetAlarmCommand" value="GVL_control.aStation[{station}].aAxis[3].reset" />
    <add key="AdsAxis3HomeCommand" value="GVL_control.aStation[{station}].aAxis[3].gohome" />
    <add key="AdsAxis3StopCommand" value="GVL_control.aStation[{station}].aAxis[3].xStop" />
    <add key="AdsAxis3JogSpeedCommand" value="GVL_control.aStation[{station}].aAxis[3].lrJogSpeed" />
    <add key="AdsAxis3JogPositiveCommand" value="GVL_control.aStation[{station}].aAxis[3].jogz" />
    <add key="AdsAxis3JogNegativeCommand" value="GVL_control.aStation[{station}].aAxis[3].jogf" />

    <!-- 轴 4 控制命令：仅写本站邮箱；四轴反馈统一读取 AdsMonitorSnapshot。 -->
    <add key="AdsAxis4EnableCommand" value="GVL_control.aStation[{station}].aAxis[4].xStart" />
    <add key="AdsAxis4ResetAlarmCommand" value="GVL_control.aStation[{station}].aAxis[4].reset" />
    <add key="AdsAxis4HomeCommand" value="GVL_control.aStation[{station}].aAxis[4].gohome" />
    <add key="AdsAxis4StopCommand" value="GVL_control.aStation[{station}].aAxis[4].xStop" />
    <add key="AdsAxis4JogSpeedCommand" value="GVL_control.aStation[{station}].aAxis[4].lrJogSpeed" />
    <add key="AdsAxis4JogPositiveCommand" value="GVL_control.aStation[{station}].aAxis[4].jogz" />
    <add key="AdsAxis4JogNegativeCommand" value="GVL_control.aStation[{station}].aAxis[4].jogf" />
  </appSettings>
</configuration>
