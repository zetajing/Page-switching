<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 默认使用模拟数据。接真实 TwinCAT 前设为 false，并填写 AMS Net ID 和下方符号名。 -->
    <add key="UseSimulation" value="true" />
    <add key="AdsAmsNetId" value="" />
    <add key="AdsPort" value="851" />
    <add key="AdsRefreshIntervalMs" value="100" />
    <add key="AxisUnit" value="°" />
    <add key="AxisMinimum" value="-20" />
    <add key="AxisMaximum" value="20" />

    <!-- 轴 1 ADS 符号映射：留空时真实模式只显示“未配置”，不会执行写入。 -->
    <add key="AdsAxis1ActualPosition" value="" />
    <add key="AdsAxis1Speed" value="" />
    <add key="AdsAxis1Enabled" value="" />
    <add key="AdsAxis1Homed" value="" />
    <add key="AdsAxis1Alarm" value="" />
    <add key="AdsAxis1PositiveLimit" value="" />
    <add key="AdsAxis1NegativeLimit" value="" />
    <add key="AdsAxis1OriginSignal" value="" />
    <add key="AdsAxis1EnableCommand" value="" />
    <add key="AdsAxis1ResetAlarmCommand" value="" />
    <add key="AdsAxis1HomeCommand" value="" />
    <add key="AdsAxis1StopCommand" value="" />
    <add key="AdsAxis1JogSpeedCommand" value="" />
    <add key="AdsAxis1JogPositiveCommand" value="" />
    <add key="AdsAxis1JogNegativeCommand" value="" />

    <!-- 轴 2 -->
    <add key="AdsAxis2ActualPosition" value="" />
    <add key="AdsAxis2Speed" value="" />
    <add key="AdsAxis2Enabled" value="" />
    <add key="AdsAxis2Homed" value="" />
    <add key="AdsAxis2Alarm" value="" />
    <add key="AdsAxis2PositiveLimit" value="" />
    <add key="AdsAxis2NegativeLimit" value="" />
    <add key="AdsAxis2OriginSignal" value="" />
    <add key="AdsAxis2EnableCommand" value="" />
    <add key="AdsAxis2ResetAlarmCommand" value="" />
    <add key="AdsAxis2HomeCommand" value="" />
    <add key="AdsAxis2StopCommand" value="" />
    <add key="AdsAxis2JogSpeedCommand" value="" />
    <add key="AdsAxis2JogPositiveCommand" value="" />
    <add key="AdsAxis2JogNegativeCommand" value="" />

    <!-- 轴 3 -->
    <add key="AdsAxis3ActualPosition" value="" />
    <add key="AdsAxis3Speed" value="" />
    <add key="AdsAxis3Enabled" value="" />
    <add key="AdsAxis3Homed" value="" />
    <add key="AdsAxis3Alarm" value="" />
    <add key="AdsAxis3PositiveLimit" value="" />
    <add key="AdsAxis3NegativeLimit" value="" />
    <add key="AdsAxis3OriginSignal" value="" />
    <add key="AdsAxis3EnableCommand" value="" />
    <add key="AdsAxis3ResetAlarmCommand" value="" />
    <add key="AdsAxis3HomeCommand" value="" />
    <add key="AdsAxis3StopCommand" value="" />
    <add key="AdsAxis3JogSpeedCommand" value="" />
    <add key="AdsAxis3JogPositiveCommand" value="" />
    <add key="AdsAxis3JogNegativeCommand" value="" />

    <!-- 轴 4 -->
    <add key="AdsAxis4ActualPosition" value="" />
    <add key="AdsAxis4Speed" value="" />
    <add key="AdsAxis4Enabled" value="" />
    <add key="AdsAxis4Homed" value="" />
    <add key="AdsAxis4Alarm" value="" />
    <add key="AdsAxis4PositiveLimit" value="" />
    <add key="AdsAxis4NegativeLimit" value="" />
    <add key="AdsAxis4OriginSignal" value="" />
    <add key="AdsAxis4EnableCommand" value="" />
    <add key="AdsAxis4ResetAlarmCommand" value="" />
    <add key="AdsAxis4HomeCommand" value="" />
    <add key="AdsAxis4StopCommand" value="" />
    <add key="AdsAxis4JogSpeedCommand" value="" />
    <add key="AdsAxis4JogPositiveCommand" value="" />
    <add key="AdsAxis4JogNegativeCommand" value="" />
  </appSettings>
</configuration>
