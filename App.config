<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 操作日志目录：留空沿用 %LOCALAPPDATA%\PageSwitching\Operations；支持绝对路径、相对程序目录的路径和环境变量。 -->
    <add key="OperationLogDirectory" value="" />
    <!-- 已完成只读 ADS 探测；四轴符号仍待确认，暂不具备轴控制条件。 -->
    <add key="AdsAmsNetId" value="192.168.0.55.1.1" />
    <add key="AdsPort" value="851" />
    <add key="AdsConnectTimeoutMs" value="10000" />
    <add key="AdsOperationTimeoutMs" value="5000" />
    <add key="AdsRefreshIntervalMs" value="100" />
    <!-- 自动页只读监控接口；由 PLC 新增 GVL_HMI 并持续更新，定义见 docs/PlcMonitoringContract.md。 -->
    <!-- 单次 ADS 请求为 1000 ms；整轮 33 个变量限时 3000 ms，首次获取句柄，后续直接读取。 -->
    <add key="AdsMonitorRefreshTimeoutMs" value="3000" />
    <add key="AdsMonitorControlOwner" value="GVL_HMI.nControlOwner" />
    <add key="AdsMonitorControlMode" value="GVL_HMI.nControlMode" />
    <add key="AdsMonitorWaveState" value="GVL_HMI.nWaveState" />
    <add key="AdsMonitorWaveFaultCode" value="GVL_HMI.udiWaveFaultCode" />
    <add key="AdsMonitorHeartbeat" value="GVL_HMI.udiHeartbeat" />
    <!-- 73 电脑使用系统 Router，保持 false；113 电脑没有 TwinCAT Router，启用后使用下列配置。
         两台电脑的连接及回程路由说明见 docs/AdsConnectionGuide.md。 -->
    <add key="AdsTcpRouterEnabled" value="false" />
    <add key="AdsTcpRouterName" value="PageSwitchingRouter" />
    <add key="AdsTcpRouterLocalNetId" value="192.168.1.113.1.1" />
    <add key="AdsTcpRouterTcpPort" value="48898" />
    <add key="AdsTcpRouterLoopbackIp" value="127.0.0.1" />
    <add key="AdsTcpRouterLoopbackPort" value="48898" />
    <add key="AdsTcpRouterRemoteName" value="WaveMakerPlc" />
    <add key="AdsTcpRouterRemoteAddress" value="192.168.1.73" />
    <add key="AdsTcpRouterRemoteNetId" value="192.168.0.55.1.1" />
    <!-- 浪高仪 TCP 参数：默认值沿用旧上位机连接窗口。 -->
    <add key="WaveHeightMeterIp" value="192.168.0.7" />
    <add key="WaveHeightMeterPort" value="502" />
    <add key="WaveHeightMeterSampleRateHz" value="50" />
    <add key="WaveHeightMeterSampleCount" value="4096" />
    <add key="AxisUnit" value="°" />
    <add key="AxisMinimum" value="-20" />
    <add key="AxisMaximum" value="20" />

    <!-- 数据库：只用于运行日志和操作追溯，不参与 PLC 实时控制。 -->
    <add key="DatabaseEnabled" value="false" />
    <add key="DatabaseProvider" value="SQL Server" />
    <add key="DatabaseConnectionString" value="Server=localhost;Database=WaveControl;Integrated Security=True;TrustServerCertificate=True" />
    <add key="DatabaseUserName" value="" />
    <add key="DatabasePassword" value="" />

    <!-- 波形生成方案：ExternalExe=WFast.exe，WaveMaker=内置算法，LegacyExe=旧WP-5-6.exe。 -->
    <add key="WaveGeneratorMode" value="ExternalExe" />
    <!-- 选择 ExternalExe 时填写 WFast.exe 路径；选择 WaveMaker 时可留空。 -->
    <add key="WaveGeneratorPath" value="" />
    <!-- 旧波形生成、修正和分析EXE的目录，在系统配置中设置。 -->
    <add key="WaveProgramDirectory" value="" />

    <!-- 轴 1 ADS 符号映射：PLC 结构为 IN1。 -->
    <add key="AdsAxis1ActualPosition" value="IN1.Axis1.lrActualPosition" />
    <add key="AdsAxis1Speed" value="IN1.Axis1.lrSpeed" />
    <add key="AdsAxis1Enabled" value="IN1.Axis1.xMotorRun" />
    <add key="AdsAxis1Homed" value="IN1.Axis1.xHomed" />
    <add key="AdsAxis1Alarm" value="IN1.Axis1.xError" />
    <add key="AdsAxis1PositiveLimit" value="IN1.Axis1.xPositiveLimit" />
    <add key="AdsAxis1NegativeLimit" value="IN1.Axis1.xNegativeLimit" />
    <add key="AdsAxis1OriginSignal" value="IN1.Axis1.xOriginSignal" />
    <add key="AdsAxis1EnableCommand" value="IN1.Axis1.xStart" />
    <add key="AdsAxis1ResetAlarmCommand" value="IN1.Axis1.reset" />
    <add key="AdsAxis1HomeCommand" value="IN1.Axis1.gohome" />
    <add key="AdsAxis1StopCommand" value="IN1.Axis1.xStop" />
    <add key="AdsAxis1JogSpeedCommand" value="IN1.Axis1.lrJogSpeed" />
    <add key="AdsAxis1JogPositiveCommand" value="IN1.Axis1.jogf" />
    <add key="AdsAxis1JogNegativeCommand" value="IN1.Axis1.jogz" />

    <!-- 轴 2 ADS 符号映射：PLC 结构为 IN1.Axis2。 -->
    <add key="AdsAxis2ActualPosition" value="IN1.Axis2.lrActualPosition" />
    <add key="AdsAxis2Speed" value="IN1.Axis2.lrSpeed" />
    <add key="AdsAxis2Enabled" value="IN1.Axis2.xMotorRun" />
    <add key="AdsAxis2Homed" value="IN1.Axis2.xHomed" />
    <add key="AdsAxis2Alarm" value="IN1.Axis2.xError" />
    <add key="AdsAxis2PositiveLimit" value="IN1.Axis2.xPositiveLimit" />
    <add key="AdsAxis2NegativeLimit" value="IN1.Axis2.xNegativeLimit" />
    <add key="AdsAxis2OriginSignal" value="IN1.Axis2.xOriginSignal" />
    <add key="AdsAxis2EnableCommand" value="IN1.Axis2.xStart" />
    <add key="AdsAxis2ResetAlarmCommand" value="IN1.Axis2.reset" />
    <add key="AdsAxis2HomeCommand" value="IN1.Axis2.gohome" />
    <add key="AdsAxis2StopCommand" value="IN1.Axis2.xStop" />
    <add key="AdsAxis2JogSpeedCommand" value="IN1.Axis2.lrJogSpeed" />
    <add key="AdsAxis2JogPositiveCommand" value="IN1.Axis2.jogf" />
    <add key="AdsAxis2JogNegativeCommand" value="IN1.Axis2.jogz" />

    <!-- 轴 3 ADS 符号映射：PLC 结构为 IN1.Axis3。 -->
    <add key="AdsAxis3ActualPosition" value="IN1.Axis3.lrActualPosition" />
    <add key="AdsAxis3Speed" value="IN1.Axis3.lrSpeed" />
    <add key="AdsAxis3Enabled" value="IN1.Axis3.xMotorRun" />
    <add key="AdsAxis3Homed" value="IN1.Axis3.xHomed" />
    <add key="AdsAxis3Alarm" value="IN1.Axis3.xError" />
    <add key="AdsAxis3PositiveLimit" value="IN1.Axis3.xPositiveLimit" />
    <add key="AdsAxis3NegativeLimit" value="IN1.Axis3.xNegativeLimit" />
    <add key="AdsAxis3OriginSignal" value="IN1.Axis3.xOriginSignal" />
    <add key="AdsAxis3EnableCommand" value="IN1.Axis3.xStart" />
    <add key="AdsAxis3ResetAlarmCommand" value="IN1.Axis3.reset" />
    <add key="AdsAxis3HomeCommand" value="IN1.Axis3.gohome" />
    <add key="AdsAxis3StopCommand" value="IN1.Axis3.xStop" />
    <add key="AdsAxis3JogSpeedCommand" value="IN1.Axis3.lrJogSpeed" />
    <add key="AdsAxis3JogPositiveCommand" value="IN1.Axis3.jogf" />
    <add key="AdsAxis3JogNegativeCommand" value="IN1.Axis3.jogz" />

    <!-- 轴 4 ADS 符号映射：PLC 结构为 IN1.Axis4。 -->
    <add key="AdsAxis4ActualPosition" value="IN1.Axis4.lrActualPosition" />
    <add key="AdsAxis4Speed" value="IN1.Axis4.lrSpeed" />
    <add key="AdsAxis4Enabled" value="IN1.Axis4.xMotorRun" />
    <add key="AdsAxis4Homed" value="IN1.Axis4.xHomed" />
    <add key="AdsAxis4Alarm" value="IN1.Axis4.xError" />
    <add key="AdsAxis4PositiveLimit" value="IN1.Axis4.xPositiveLimit" />
    <add key="AdsAxis4NegativeLimit" value="IN1.Axis4.xNegativeLimit" />
    <add key="AdsAxis4OriginSignal" value="IN1.Axis4.xOriginSignal" />
    <add key="AdsAxis4EnableCommand" value="IN1.Axis4.xStart" />
    <add key="AdsAxis4ResetAlarmCommand" value="IN1.Axis4.reset" />
    <add key="AdsAxis4HomeCommand" value="IN1.Axis4.gohome" />
    <add key="AdsAxis4StopCommand" value="IN1.Axis4.xStop" />
    <add key="AdsAxis4JogSpeedCommand" value="IN1.Axis4.lrJogSpeed" />
    <add key="AdsAxis4JogPositiveCommand" value="IN1.Axis4.jogf" />
    <add key="AdsAxis4JogNegativeCommand" value="IN1.Axis4.jogz" />
  </appSettings>
</configuration>
