<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- S7 连接参数统一从这里读取；修改后重新启动程序。 -->
    <add key="S7IpAddress" value="127.0.0.1" />
    <add key="S7Rack" value="0" />
    <add key="S7Slot" value="1" />
    <add key="AutoRefreshIntervalMs" value="100" />
  </appSettings>
</configuration>
